# Copy this file to .env and fill in real values. Never commit .env itself.

# OpenRouter API key — used to access LLMs for slide/storyline generation.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Server
PORT=8787
CORS_ORIGIN=http://localhost:3301
SERVICE_PUBLIC_URL=http://localhost:8787

# Model slugs — override if OpenRouter renames/retires one. Run `npm run
# smoke` to verify all four resolve before relying on this list.
MODEL_ORCHESTRATOR=openai/gpt-5.6-luna
MODEL_COPYWRITER=anthropic/claude-sonnet-5
MODEL_DESIGNER_IMAGE=black-forest-labs/flux.2-pro
MODEL_DESIGNER_VECTOR=recraft/recraft-v4.1

# Designer cost controls — every /approve with images on spends real
# OpenRouter credits (up to MAX_IMAGES_PER_DECK image generations + 3 LLM
# calls). Set IMAGES_ENABLED=false to iterate on the copy pipeline for free.
IMAGES_ENABLED=true
MAX_IMAGES_PER_DECK=3
