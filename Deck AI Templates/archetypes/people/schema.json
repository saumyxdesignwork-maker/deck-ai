  "required": [
    "people"
  ],
  "additionalProperties": false,
  "properties": {
    "eyebrow": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "intro": {
      "type": "string"
    },
    "lead": {
      "type": "string"
    },
    "people": {
